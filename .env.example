# Real Estate Platform — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
API_PORT=3000
API_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# ---------------------------------------------------------------------------
# PostgreSQL / Prisma
# ---------------------------------------------------------------------------
POSTGRES_USER=realestate
POSTGRES_PASSWORD=realestate
POSTGRES_DB=realestate_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://realestate:realestate@localhost:5432/realestate_dev?schema=public

# ---------------------------------------------------------------------------
# Redis (cache / rate limiting / queues)
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth (introduced Milestone 1 — documented now so the config surface is
# stable; values below are local-dev placeholders only)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# Email verification, phone OTP, and password reset token lifetimes.
EMAIL_VERIFICATION_TTL_MINUTES=1440
PHONE_OTP_TTL_MINUTES=10
PHONE_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30

# Provider selection for verification delivery. "console" (the only
# option today) logs to the server console in development and does
# nothing in production — see apps/api/src/mail and apps/api/src/sms.
# Wire a real provider (SendGrid/SES, Twilio/SNS, etc.) before launch.
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# ---------------------------------------------------------------------------
# Admin web (apps/admin-web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Mobile (apps/mobile — Expo)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Reserved for later milestones (not consumed yet; do not implement early)
# ---------------------------------------------------------------------------
# Google Maps Platform (Milestone 3)
# GOOGLE_MAPS_API_KEY=
#
# S3-compatible object storage (Milestone 3+)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Push notifications (Milestone 7)
# PUSH_PROVIDER=
# PUSH_API_KEY=
#
# Payments (Milestone 10)
# PAYMENTS_PROVIDER=
# PAYMENTS_API_KEY=
# PAYMENTS_WEBHOOK_SECRET=
