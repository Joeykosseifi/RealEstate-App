# Real Estate Platform — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
API_PORT=3000
API_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# ---------------------------------------------------------------------------
# PostgreSQL / Prisma
# ---------------------------------------------------------------------------
POSTGRES_USER=realestate
POSTGRES_PASSWORD=realestate
POSTGRES_DB=realestate_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://realestate:realestate@localhost:5432/realestate_dev?schema=public

# ---------------------------------------------------------------------------
# Redis (cache / rate limiting / queues)
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth (introduced Milestone 1 — documented now so the config surface is
# stable; values below are local-dev placeholders only)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# Email verification, phone OTP, and password reset token lifetimes.
EMAIL_VERIFICATION_TTL_MINUTES=1440
PHONE_OTP_TTL_MINUTES=10
PHONE_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30

# Provider selection for verification delivery. "console" (the only
# option today) logs to the server console in development and does
# nothing in production — see apps/api/src/mail and apps/api/src/sms.
# Wire a real provider (SendGrid/SES, Twilio/SNS, etc.) before launch.
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# ---------------------------------------------------------------------------
# Property media storage (Milestone 3 — see docs/DATABASE.md "Property
# media storage"). "local" is the only provider today: a real filesystem
# directory, private by default, accessed only through short-lived
# signed URLs.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/property-media
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_SIGNING_SECRET=change-me-storage-signing-secret

# ---------------------------------------------------------------------------
# Admin web (apps/admin-web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Mobile (apps/mobile — Expo)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Maps Platform (Milestone 3 mobile — interactive location picker,
# see docs/API.md "Google Maps setup" and docs/PERMISSIONS.md "Google
# Maps strategy"). Required Google Cloud APIs on the project that issues
# these keys: "Maps SDK for Android", "Maps SDK for iOS", "Places API".
# GOOGLE_MAPS_ANDROID_API_KEY / GOOGLE_MAPS_IOS_API_KEY are read at Expo
# config time (apps/mobile/app.config.ts) to configure the native Maps
# SDKs — never exposed to bundled JS, so they are NOT EXPO_PUBLIC_-
# prefixed. EXPO_PUBLIC_GOOGLE_PLACES_API_KEY is used client-side for
# search/autocomplete (apps/mobile/src/location/googlePlaces.ts) and is
# inlined into the JS bundle by Expo, same as any EXPO_PUBLIC_ var — use
# a key restricted to the Places API only, never a broad/unrestricted
# key. All three may be left unset in local dev: the map still renders
# and pins can still be dropped/dragged/saved manually, but native tiles
# render blank and search throws a clear "not configured" error instead
# of silently failing. Never commit real keys.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Reserved for later milestones (not consumed yet; do not implement early)
# ---------------------------------------------------------------------------
# S3-compatible object storage (future replacement for the local
# provider above — not consumed yet)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Push notifications (Milestone 7)
# PUSH_PROVIDER=
# PUSH_API_KEY=
#
# Payments (Milestone 10)
# PAYMENTS_PROVIDER=
# PAYMENTS_API_KEY=
# PAYMENTS_WEBHOOK_SECRET=
