// Real Estate Platform — Prisma schema
//
// Milestone 0: datasource + generator only.
// Milestone 1: authentication, users, verification, sessions, and the
// minimum workspace/company/role foundation needed for automatic
// personal (agent) and company workspace creation on account activation.
// Milestone 2: the full authorization foundation — workspace/platform
// role scoping, the permission catalog, platform (admin) roles, and the
// moderation fields user suspension/deactivation/restoration need.
// Milestone 3: the professional private property database — Property
// and its related models (location, features, media, owner contacts,
// private details).
// Milestone 4: client CRM (ClientRecord), per-client property
// requirements (ClientRequirement), a shortlist relationship
// (ClientPropertyShortlist), and client-facing PDF presentations
// (PropertyPresentation/PropertyPresentationItem). Matching itself is
// computed on demand from current data (see MatchingService) — no
// match-result table.
// Milestone 5 (this revision): the publication workflow
// (PropertyPublication/PropertyPublicationVersion/
// PropertyPublicationMedia) that turns a private Property into a
// reviewed, versioned, publicly-visible marketplace listing, plus
// client-side MarketplaceFavorite. See docs/DATABASE.md for the full
// model-introduction schedule and the rationale behind specific design
// choices (e.g. `User.pendingCompanyProfile`, the workspace type CHECK
// constraint, the Role scope/uniqueness design, and the Milestone 3/4/5
// design decisions below).
//
// Do not add collaboration/subscription models yet — those belong to
// later milestones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// The onboarding path chosen at registration. This drives onboarding
/// behavior only — it is never treated as an authorization signal.
/// Authorization is always resolved from workspace membership + role +
/// permissions (see docs/PERMISSIONS.md).
enum AccountType {
  CLIENT
  AGENT
  COMPANY
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum WorkspaceType {
  PERSONAL
  COMPANY
}

enum WorkspaceMembershipType {
  OWNER
  EMPLOYEE
  FREELANCE_AGENT
  COLLABORATOR
}

enum WorkspaceMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CompanyAccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Whether a Role/Permission applies platform-wide (admin capabilities,
/// held via UserPlatformRole, independent of any workspace membership)
/// or within a single workspace (held via WorkspaceMember.roleId). A
/// WORKSPACE-scope role can only ever be granted WORKSPACE-scope
/// permissions — enforced in RolesService, not just by convention. See
/// docs/PERMISSIONS.md "Platform vs. workspace scope".
enum AuthorizationScope {
  PLATFORM
  WORKSPACE
}

// ---------------------------------------------------------------------------
// Users, sessions, verification, password reset
// ---------------------------------------------------------------------------

model User {
  id            String        @id @default(uuid()) @db.Uuid
  firstName     String
  lastName      String
  /// Always stored lowercased/trimmed — see UsersService.normalizeEmail.
  email         String        @unique
  /// E.164 format when present — see UsersService.normalizePhone.
  phone         String?       @unique
  passwordHash  String
  accountType   AccountType
  accountStatus AccountStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  lastLoginAt     DateTime?

  /// Moderation fields track only the MOST RECENT action of each kind —
  /// full history (actor, reason, previous/new status, timestamp) lives
  /// in AuditLog. These are plain scalar "actor" references (not Prisma
  /// relations) to avoid a self-relation explosion on User; a DB-level
  /// FK is still added by hand in the Milestone 2 migration. See
  /// docs/SECURITY.md "Reversible moderation".
  suspendedAt       DateTime?
  suspendedByUserId String?   @db.Uuid
  suspensionReason  String?

  deactivatedAt       DateTime?
  deactivatedByUserId String?   @db.Uuid
  deactivationReason  String?

  restoredAt       DateTime?
  restoredByUserId String?   @db.Uuid
  restoreReason    String?

  /// Transient staging area for a COMPANY registration's company details
  /// (name/email/phone/website/description), captured at registration and
  /// consumed by the activation transaction once the user verifies email
  /// + phone. Cleared (set null) once Company/Workspace/OWNER membership
  /// are created. See docs/DATABASE.md for why this isn't its own table.
  pendingCompanyProfile Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions             UserSession[]
  emailVerifications   EmailVerification[]
  phoneVerifications   PhoneVerification[]
  passwordResets       PasswordReset[]
  workspaceMemberships WorkspaceMember[]
  personalWorkspace    Workspace?             @relation("PersonalWorkspaceOwner")
  companiesCreated     Company[]              @relation("CompanyCreatedBy")
  auditLogs            AuditLog[]             @relation("AuditActor")
  platformRoles        UserPlatformRole[]
  createdProperties    Property[]             @relation("PropertyCreatedBy")
  createdClientRecords ClientRecord[]         @relation("ClientRecordCreatedBy")
  createdPresentations PropertyPresentation[] @relation("PresentationCreatedBy")
  marketplaceFavorites MarketplaceFavorite[]

  @@map("users")
}

/// One row per logged-in device/session. The refresh token presented by
/// the client encodes this row's id plus a random secret; only a hash of
/// the secret is stored here. See docs/SECURITY.md "Refresh token
/// rotation" for the full rotation + reuse-detection design.
model UserSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  userAgent String?
  ipAddress String?

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_sessions")
}

/// Link-style email verification. `tokenHash` is a SHA-256 hash of a
/// high-entropy random token; the raw token is only ever sent to the user
/// (via the mail provider) and never persisted or logged.
model EmailVerification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verifications")
}

/// Numeric-OTP phone verification. `otpHash` is a SHA-256 hash of the
/// code; lookup is always by userId (not by hash), so no uniqueness
/// constraint is needed on the hash itself.
model PhoneVerification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("phone_verifications")
}

/// Password reset token. Same shape/rationale as EmailVerification.
model PasswordReset {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Workspace / company / role foundation
//
// Full workspace management (invitations, switching, permission
// enforcement engine) is Milestone 2. This milestone only implements what
// account activation needs: creating exactly one PERSONAL workspace per
// agent, and one COMPANY workspace per company, each with an OWNER
// membership.
// ---------------------------------------------------------------------------

model Company {
  id                 String                    @id @default(uuid()) @db.Uuid
  name               String
  email              String?
  phone              String?
  website            String?
  /// Object storage reference (key/URL), wired up when file storage lands.
  logoUrl            String?
  description        String?
  verificationStatus CompanyVerificationStatus @default(PENDING)
  accountStatus      CompanyAccountStatus      @default(ACTIVE)

  createdByUserId String @db.Uuid
  createdBy       User   @relation("CompanyCreatedBy", fields: [createdByUserId], references: [id])

  workspace Workspace?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

/// A PERSONAL workspace has `personalOwnerUserId` set and `companyId`
/// null; a COMPANY workspace has `companyId` set and `personalOwnerUserId`
/// null. Enforced at the application layer AND by a DB CHECK constraint
/// (added by hand in the initial migration's migration.sql, under
/// prisma/migrations) plus the unique constraints below, which together
/// guarantee at most one personal workspace per user and at most one
/// workspace per company.
model Workspace {
  id   String        @id @default(uuid()) @db.Uuid
  type WorkspaceType
  name String

  personalOwnerUserId String? @unique @db.Uuid
  personalOwner       User?   @relation("PersonalWorkspaceOwner", fields: [personalOwnerUserId], references: [id])

  companyId String?  @unique @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  members       WorkspaceMember[]
  customRoles   Role[]                 @relation("WorkspaceCustomRoles")
  properties    Property[]
  clients       ClientRecord[]
  presentations PropertyPresentation[]
  publications  PropertyPublication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  membershipType WorkspaceMembershipType
  status         WorkspaceMembershipStatus @default(ACTIVE)

  roleId String? @db.Uuid
  role   Role?   @relation(fields: [roleId], references: [id])

  /// Plain scalar actor references (see User's moderation fields for why
  /// these aren't Prisma relations) — full detail lives in AuditLog.
  invitedByUserId   String? @db.Uuid
  suspendedByUserId String? @db.Uuid
  removedByUserId   String? @db.Uuid

  invitedAt   DateTime?
  joinedAt    DateTime?
  suspendedAt DateTime?
  removedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Prevents duplicate memberships (and therefore duplicate OWNER grants)
  /// for the same user in the same workspace, even under concurrent
  /// activation attempts (enforced at the DB level, not just in code).
  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// A named, permission-bearing role. Two kinds:
///
/// - **System roles** (`isSystem: true`, `workspaceId: null`) — the fixed
///   catalog seeded by `prisma/seed.ts` (workspace roles like AGENT,
///   VIEWER, WORKSPACE_OWNER; platform roles like SUPER_ADMIN). Their
///   `key` must be globally unique — enforced by a hand-added partial
///   unique index (`WHERE "workspaceId" IS NULL`) in the Milestone 2
///   migration, since the ordinary composite `@@unique` below does not
///   by itself stop two different NULL-workspaceId rows from sharing a
///   key (NULL is never "equal" to NULL in a SQL unique constraint).
/// - **Custom workspace roles** (`isSystem: false`, `workspaceId` set) —
///   created by a workspace via `workspace.manage_roles` (e.g. "Senior
///   Agent"). `key` only needs to be unique within that one workspace,
///   which the composite `@@unique([workspaceId, key])` does enforce.
///
/// `scope` determines what a role's permissions may contain: a
/// WORKSPACE-scope role can only ever be granted WORKSPACE-scope
/// permissions (checked in RolesService whenever role-permission
/// mappings are written, for both system seeding and custom-role
/// CRUD) — a company admin can never construct a role carrying a
/// PLATFORM permission. Platform roles are assigned to users directly
/// via `UserPlatformRole`, never via `WorkspaceMember.roleId`.
model Role {
  id          String             @id @default(uuid()) @db.Uuid
  key         String
  name        String
  description String?
  scope       AuthorizationScope @default(WORKSPACE)
  isSystem    Boolean            @default(false)

  /// Set only for custom (non-system) workspace roles.
  workspaceId String?    @db.Uuid
  workspace   Workspace? @relation("WorkspaceCustomRoles", fields: [workspaceId], references: [id], onDelete: Cascade)

  permissions   RolePermission[]
  members       WorkspaceMember[]
  platformGrant UserPlatformRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, key])
  @@index([scope])
  @@map("roles")
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  key         String             @unique
  description String?
  scope       AuthorizationScope

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@index([scope])
  @@map("permissions")
}

/// Grants a PLATFORM-scope Role directly to a User, independent of any
/// workspace membership — this is how SUPER_ADMIN/PLATFORM_ADMIN/etc.
/// work without requiring the admin to join every workspace they
/// administer. RolesService rejects granting a WORKSPACE-scope role here.
model UserPlatformRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  /// Plain scalar actor reference — see User's moderation fields.
  grantedByUserId String? @db.Uuid

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_platform_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

/// Append-only audit trail. Never write secrets (passwords, tokens, OTPs)
/// into `metadata` — see docs/SECURITY.md.
model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  actorUserId String? @db.Uuid
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Milestone 3 — Property database
//
// A Property belongs to exactly one workspace (its business owner) —
// `workspaceId` is never changeable via update, only set at creation.
// `createdByUserId` is a separate concept: the person who entered the
// record, which may differ from the workspace (e.g. a company employee
// creating a property that belongs to the company workspace, not their
// own personal one). See docs/PERMISSIONS.md "Property ownership vs.
// authorship."
//
// Business status (this milestone) and publication status (Milestone 5,
// not modeled yet) are deliberately separate concerns — see
// docs/PERMISSIONS.md "Property status model."
// ---------------------------------------------------------------------------

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  LAND
  OFFICE
  SHOP
  COMMERCIAL
  WAREHOUSE
  BUILDING
  CHALET
  OTHER
}

enum ListingPurpose {
  SALE
  RENT
}

/// Business status only — never conflated with publication status
/// (Milestone 5). ARCHIVED is reached via the archive endpoint, not a
/// direct status-change call — see PropertiesService.
enum PropertyBusinessStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  OFF_MARKET
  ARCHIVED
}

/// How the saved lat/lng was obtained — captured for provenance, not
/// authorization. The database coordinates are the source of truth
/// regardless of source; googlePlaceId is a convenience reference, never
/// relied on exclusively (see docs/PERMISSIONS.md "Google Maps
/// strategy").
enum PropertyLocationSource {
  GOOGLE_SEARCH
  MAP_PIN
  CURRENT_LOCATION
  MANUAL
}

/// Independent of workspace-level permissions — this is the FUTURE
/// public/marketplace visibility rule (consumed starting Milestone 5/6).
/// Milestone 3 only enforces the professional-side permission
/// (`property.view_exact_location`) for exposing coordinates within a
/// workspace; it does not yet build any public/client-facing endpoint
/// that reads this field.
enum PropertyLocationVisibility {
  PRIVATE
  WORKSPACE
  PUBLIC_APPROXIMATE
  PUBLIC_EXACT
}

enum PropertyMediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Property {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdByUserId String @db.Uuid
  createdBy       User   @relation("PropertyCreatedBy", fields: [createdByUserId], references: [id])

  propertyType   PropertyType
  listingPurpose ListingPurpose
  title          String
  description    String?

  /// Stored as Decimal (never float) to avoid rounding drift; mapped to
  /// a plain `number` in API responses (see property.mapper.ts) — safely
  /// within JS's safe-integer range for realistic property prices.
  price    Decimal @db.Decimal(14, 2)
  currency String  @db.Char(3)

  bedrooms    Int?
  bathrooms   Int?
  areaSqm     Decimal? @db.Decimal(10, 2)
  floor       Int?
  totalFloors Int?
  yearBuilt   Int?

  propertyStatus PropertyBusinessStatus @default(AVAILABLE)

  /// Plain scalar actor reference (see User's moderation fields for the
  /// established rationale) — full detail lives in AuditLog.
  archivedAt       DateTime?
  archivedByUserId String?   @db.Uuid

  location       PropertyLocation?
  features       PropertyFeature[]
  media          PropertyMedia[]
  owners         PropertyOwner[]
  privateDetails PropertyPrivateDetails?
  shortlistedFor ClientPropertyShortlist[]
  presentedIn    PropertyPresentationItem[]
  publication    PropertyPublication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, propertyStatus])
  @@index([workspaceId, propertyType])
  @@index([workspaceId, listingPurpose])
  @@index([workspaceId, price])
  @@index([createdByUserId])
  @@map("properties")
}

/// One-to-one with Property. The exact coordinates are the permanent
/// source of truth once saved — see docs/PERMISSIONS.md "Google Maps
/// strategy." `Decimal(9,6)` comfortably covers the valid ranges
/// (latitude -90..90, longitude -180..180) at ~0.11m precision.
model PropertyLocation {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @unique @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  country String?
  region  String?
  city    String?
  area    String?
  address String?

  latitude      Decimal @db.Decimal(9, 6)
  longitude     Decimal @db.Decimal(9, 6)
  googlePlaceId String?

  locationSource     PropertyLocationSource     @default(MANUAL)
  locationVisibility PropertyLocationVisibility @default(PRIVATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([area])
  @@index([country, city, area])
  @@map("property_locations")
}

/// Flexible feature/amenity storage — a normalized key + boolean value,
/// not one column per amenity, so adding a new feature never requires a
/// migration. `featureKey` is validated at the API layer against
/// `apps/api/src/properties/property-features.catalog.ts` (the same
/// "single source of truth catalog" pattern as permissions), not by a
/// DB-level enum/foreign key — see docs/DATABASE.md "Property feature
/// storage."
model PropertyFeature {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  featureKey String
  value      Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([propertyId, featureKey])
  @@map("property_features")
}

/// `storageKey` is an opaque object-storage reference, never a public
/// URL — see StorageService. Exactly one row per property may have
/// `isPrimary = true`, enforced by a hand-added partial unique index in
/// this milestone's migration (see docs/DATABASE.md "Main photo rule").
model PropertyMedia {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  mediaType        PropertyMediaType
  storageKey       String
  originalFileName String
  mimeType         String
  fileSize         Int
  sortOrder        Int               @default(0)
  isPrimary        Boolean           @default(false)

  uploadedByUserId String @db.Uuid

  createdAt DateTime @default(now())

  publicationSelections PropertyPublicationMedia[]

  @@index([propertyId, sortOrder])
  @@map("property_media")
}

/// Private professional data — never included in any public DTO. Access
/// requires `property.view_owner`, independent of `property.view`. A
/// property may have more than one owner/contact row (co-owners, an
/// agent-side contact, etc.).
model PropertyOwner {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  fullName      String
  phone         String?
  email         String?
  whatsappPhone String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@map("property_owners")
}

/// One-to-one with Property. `internalNotes`/`acquisitionSource`/
/// `internalReference`/`privateStatusNotes` require
/// `property.view_private_notes`; `commissionNotes` additionally
/// requires `property.view_commission` on top of that — see
/// docs/PERMISSIONS.md "Sensitive property fields."
model PropertyPrivateDetails {
  propertyId String   @id @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  internalNotes      String?
  commissionNotes    String?
  acquisitionSource  String?
  internalReference  String?
  privateStatusNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("property_private_details")
}

// ---------------------------------------------------------------------------
// Milestone 4 — Client CRM, requirements, shortlist, presentations
//
// A ClientRecord (an agent's/company's own customer) belongs to exactly
// one workspace, following the identical ownership-vs-authorship split
// as Property: `workspaceId` is the immutable business owner, set once
// at creation; `createdByUserId` is the author, which may be a
// different person (e.g. a company employee entering a client that
// belongs to the company workspace). A ClientRecord is NOT a platform
// user account (`AccountType.CLIENT`) — most CRM clients never register
// at all. `platformUserId` is a nullable, unenforced scalar reserved for
// a future linking feature; Milestone 4 does not build any linking flow.
// See docs/PRODUCT.md "CRM client vs. platform client."
//
// Matching (requirement -> candidate properties) is deliberately NOT a
// stored table — see apps/api/src/clients/matching.service.ts. Property
// prices/status/features can change after the fact, so matches are
// always computed fresh from current data; nothing here would be a
// meaningful "match record" to keep in sync.
// ---------------------------------------------------------------------------

enum ClientRecordStatus {
  LEAD
  ACTIVE
  QUALIFIED
  VIEWING
  NEGOTIATING
  WON
  LOST
  INACTIVE
  ARCHIVED
}

enum ClientSource {
  REFERRAL
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEBSITE
  PHONE
  WALK_IN
  PROPERTY_INQUIRY
  OTHER
}

enum PreferredContactMethod {
  PHONE
  WHATSAPP
  EMAIL
  OTHER
}

enum ClientRequirementStatus {
  ACTIVE
  PAUSED
  FULFILLED
  ARCHIVED
}

enum PresentationStatus {
  DRAFT
  GENERATED
  ARCHIVED
}

model ClientRecord {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdByUserId String @db.Uuid
  createdBy       User   @relation("ClientRecordCreatedBy", fields: [createdByUserId], references: [id])

  /// Plain scalar actor/assignment references (see User's moderation
  /// fields for the established rationale — no Prisma relation, no
  /// hand-added FK either, matching Property.archivedByUserId's exact
  /// precedent). An assignment target is re-verified (same workspace,
  /// ACTIVE membership) at write time in ClientsService, never trusted
  /// from a stale reference alone — assigning never grants additional
  /// workspace permissions by itself.
  assignedToUserId String? @db.Uuid
  /// Reserved for a future platform-account linking feature — not
  /// enforced, not surfaced by any endpoint yet.
  platformUserId   String? @db.Uuid

  firstName     String
  lastName      String
  phone         String
  whatsappPhone String?
  email         String?

  preferredContactMethod PreferredContactMethod?
  source                 ClientSource?
  status                 ClientRecordStatus      @default(LEAD)
  notes                  String?

  archivedAt       DateTime?
  archivedByUserId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements  ClientRequirement[]
  shortlist     ClientPropertyShortlist[]
  presentations PropertyPresentation[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([assignedToUserId])
  @@index([createdByUserId])
  @@index([phone])
  @@index([email])
  @@map("client_records")
}

/// A client may have multiple requirements over time (e.g. an apartment
/// to buy AND land to invest in) — never restricted to one. Hard
/// (must-have) criteria are the typed min/max/enum/array columns below,
/// evaluated by MatchingService as candidate-excluding filters; soft
/// (nice-to-have) criteria are `preferredFeatures` only, which raise a
/// match's score but never exclude a property. See
/// apps/api/src/clients/matching.service.ts for exactly how each field
/// is used. Every array field defaults to empty, meaning "no constraint
/// on this dimension" — e.g. an empty `cities` accepts any city.
model ClientRequirement {
  id       String       @id @default(uuid()) @db.Uuid
  clientId String       @db.Uuid
  client   ClientRecord @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Denormalized from the parent client at creation, immutable —
  /// enables workspace-scoped queries directly on this table without a
  /// join. Re-validated against the parent client's own workspaceId on
  /// every write in ClientRequirementsService, so a requirement can
  /// never end up attached to a client from a different workspace.
  workspaceId     String @db.Uuid
  createdByUserId String @db.Uuid

  title          String
  listingPurpose ListingPurpose
  propertyTypes  PropertyType[]

  minPrice Decimal? @db.Decimal(14, 2)
  maxPrice Decimal? @db.Decimal(14, 2)
  /// Required (validated at the DTO layer) whenever minPrice or maxPrice
  /// is set — see docs/PERMISSIONS.md "Matching currency rule": prices
  /// are never compared across currencies.
  currency String?  @db.Char(3)

  minBedrooms  Int?
  maxBedrooms  Int?
  minBathrooms Int?
  minAreaSqm   Decimal? @db.Decimal(10, 2)
  maxAreaSqm   Decimal? @db.Decimal(10, 2)

  countries String[]
  cities    String[]
  areas     String[]

  /// Feature keys drawn from the identical
  /// apps/api/src/properties/property-features.catalog.ts vocabulary a
  /// Property's own features use — never a second, incompatible
  /// amenity list.
  requiredFeatures  String[]
  preferredFeatures String[]

  notes  String?
  status ClientRequirementStatus @default(ACTIVE)

  archivedAt       DateTime?
  archivedByUserId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shortlist     ClientPropertyShortlist[]
  presentations PropertyPresentation[]

  @@index([clientId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("client_requirements")
}

/// A property saved/shortlisted for a client, optionally tied to the
/// requirement that motivated it. `@@unique([clientId, propertyId])`
/// prevents the same property being shortlisted twice for the same
/// client at the database level, not just in application code.
model ClientPropertyShortlist {
  id String @id @default(uuid()) @db.Uuid

  /// Denormalized from `client.workspaceId` at creation, immutable — see
  /// ClientRequirement.workspaceId for the identical rationale.
  workspaceId String @db.Uuid

  clientId String       @db.Uuid
  client   ClientRecord @relation(fields: [clientId], references: [id], onDelete: Cascade)

  requirementId String?            @db.Uuid
  requirement   ClientRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  addedByUserId String  @db.Uuid
  note          String?

  createdAt DateTime @default(now())

  @@unique([clientId, propertyId])
  @@index([workspaceId])
  @@index([requirementId])
  @@index([propertyId])
  @@map("client_property_shortlists")
}

/// A client-facing selection of properties turned into a PDF. `clientId`
/// / `requirementId` are optional (an ad-hoc presentation need not be
/// tied to either), but every `PropertyPresentationItem.propertyId` is
/// verified against `workspaceId` at write time regardless — see
/// docs/PERMISSIONS.md "Presentation authorization."
///
/// Versioning: `storageKey`/`generatedAt` always point at the MOST
/// RECENTLY generated PDF. Pressing "Generate" again writes a brand new
/// object under a new key (see PresentationsService) and repoints these
/// two fields — it never overwrites the previous artifact in place, and
/// the previous artifact is left in storage (not deleted, not
/// referenced anywhere once superseded). Editing title/items/notes on a
/// GENERATED presentation moves its status back to DRAFT without
/// touching the still-valid, still-accessible previously generated
/// artifact until an explicit regeneration.
model PropertyPresentation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  clientId String?       @db.Uuid
  client   ClientRecord? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  requirementId String?            @db.Uuid
  requirement   ClientRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  createdByUserId String @db.Uuid
  createdBy       User   @relation("PresentationCreatedBy", fields: [createdByUserId], references: [id])

  title  String
  status PresentationStatus @default(DRAFT)

  generatedAt DateTime?
  storageKey  String?

  archivedAt       DateTime?
  archivedByUserId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PropertyPresentationItem[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([requirementId])
  @@index([status])
  @@index([workspaceId, createdAt])
  @@map("property_presentations")
}

/// The properties selected for one presentation, in send order. No
/// per-item snapshot fields — the generated PDF binary itself (stored
/// via StorageService, see PropertyPresentation.storageKey) is the
/// historical record of exactly what was sent; regenerating always
/// reads current property data, by design (see docs/DATABASE.md
/// "Presentation snapshot strategy").
model PropertyPresentationItem {
  id             String               @id @default(uuid()) @db.Uuid
  presentationId String               @db.Uuid
  presentation   PropertyPresentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  sortOrder Int
  agentNote String?

  createdAt DateTime @default(now())

  @@unique([presentationId, propertyId])
  @@index([presentationId])
  @@index([propertyId])
  @@map("property_presentation_items")
}

// ---------------------------------------------------------------------------
// Milestone 5 — Publication workflow, admin approval & client marketplace
//
// Every property is PRIVATE by default. `PropertyPublication` is the
// separate visibility/review layer over a `Property` — one row per
// property, created lazily the first time a professional starts
// preparing a public listing. A property with NO `PropertyPublication`
// row is implicitly in the PRIVATE state (never stored — see
// `PropertyPublicationStatus` doc comment below).
//
// Versioning: `PropertyPublication` holds the *current lifecycle state*;
// `PropertyPublicationVersion` is an append-only, immutable-once-submitted
// history of every submission, satisfying both "admin reviews an exact,
// stable snapshot" (never the live, possibly-since-edited Property) and
// "preserve full review history" in one table. `latestVersionId` points
// at the version currently being drafted/reviewed; `publishedVersionId`
// points at whichever version is the one *currently live to the public*
// — these are deliberately different pointers so a newer pending edit
// can be under review without touching what's already published (see
// docs/DATABASE.md "Publication versioning").
// ---------------------------------------------------------------------------

/// PRIVATE is never a stored value — the absence of a `PropertyPublication`
/// row for a property IS the PRIVATE state. Every other value is a real
/// column value. See docs/DATABASE.md "Publication state machine" for
/// the full transition diagram.
enum PropertyPublicationStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
  REJECTED
  ADMIN_UNPUBLISHED
  OWNER_UNPUBLISHED
  ARCHIVED
}

/// Per-submission status, stored on each immutable
/// `PropertyPublicationVersion` row — independent of, but kept in sync
/// with, `PropertyPublication.status` (see PublicationsService).
enum PropertyPublicationVersionStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

model PropertyPublication {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @unique @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Denormalized from `Property.workspaceId` at creation — never changes
  /// (ownership is immutable; see docs/PERMISSIONS.md). A real relation
  /// (not just a scalar) so the admin queue/review detail can join the
  /// workspace's display name without a second query.
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status PropertyPublicationStatus @default(DRAFT)

  /// The version currently being drafted, under review, or most recently
  /// decided — NOT necessarily the one currently public. Null only
  /// before the very first draft is created (impossible in practice: the
  /// row itself is created atomically with version 1).
  latestVersionId String?                     @unique @db.Uuid
  latestVersion   PropertyPublicationVersion? @relation("LatestVersion", fields: [latestVersionId], references: [id])

  /// The version currently visible on the public marketplace. Only ever
  /// updated atomically on approval — see PublicationsAdminService.approve.
  publishedVersionId String?                     @unique @db.Uuid
  publishedVersion   PropertyPublicationVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id])

  submittedByUserId String?   @db.Uuid
  submittedAt       DateTime?

  approvedByUserId String?   @db.Uuid
  approvedAt       DateTime?

  rejectedByUserId String?   @db.Uuid
  rejectedAt       DateTime?
  rejectionReason  String?

  changesRequestedByUserId String?   @db.Uuid
  changesRequestedAt       DateTime?
  changesRequestedReason   String?

  publishedAt DateTime?

  unpublishedAt       DateTime?
  unpublishedByUserId String?   @db.Uuid
  unpublishReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions             PropertyPublicationVersion[] @relation("PublicationVersions")
  marketplaceFavorites MarketplaceFavorite[]

  @@index([workspaceId])
  @@index([status])
  @@index([workspaceId, status])
  @@index([submittedAt])
  @@index([publishedAt])
  @@map("property_publications")
}

/// Immutable once its status leaves DRAFT (enforced in
/// PublicationsService, not the DB — see docs/DATABASE.md). Contains
/// ONLY explicitly-allowlisted public-safe fields: never the professional
/// `Property`/`PropertyOwner`/`PropertyPrivateDetails` rows, and never a
/// "professional DTO minus a few fields" — see `publication.mapper.ts`.
model PropertyPublicationVersion {
  id            String              @id @default(uuid()) @db.Uuid
  publicationId String              @db.Uuid
  publication   PropertyPublication @relation("PublicationVersions", fields: [publicationId], references: [id], onDelete: Cascade)

  versionNumber Int

  status PropertyPublicationVersionStatus @default(DRAFT)

  publicTitle       String
  publicDescription String?
  publicPrice       Decimal        @db.Decimal(14, 2)
  currency          String         @db.Char(3)
  propertyType      PropertyType
  listingPurpose    ListingPurpose
  bedrooms          Int?
  bathrooms         Int?
  areaSqm           Decimal?       @db.Decimal(10, 2)

  /// Feature keys from the same canonical catalog as the professional
  /// record (see property-features.catalog.ts) — never a parallel
  /// vocabulary. Selected explicitly by the professional as public-safe;
  /// not automatically copied from the private record.
  publicFeatureKeys String[]

  /// Reuses `PropertyLocationVisibility` (Milestone 3 foundation, now
  /// enforced). PRIVATE/WORKSPACE never populate public lat/lng below —
  /// see docs/PERMISSIONS.md "Public location rules".
  locationVisibility PropertyLocationVisibility
  publicCountry      String?
  publicCity         String?
  publicArea         String?
  publicLatitude     Decimal?                   @db.Decimal(9, 6)
  publicLongitude    Decimal?                   @db.Decimal(9, 6)

  submittedByUserId String?   @db.Uuid
  submittedAt       DateTime?

  /// The actor/timestamp/reason of THIS version's most recent review
  /// decision (approve/reject/request-changes) — one row per submission,
  /// so this is never overwritten by a later version's decision.
  reviewedByUserId String?   @db.Uuid
  reviewedAt       DateTime?
  reviewReason     String?

  createdAt DateTime @default(now())

  media PropertyPublicationMedia[]

  currentForPublication   PropertyPublication? @relation("LatestVersion")
  publishedForPublication PropertyPublication? @relation("PublishedVersion")

  @@unique([publicationId, versionNumber])
  @@index([publicationId])
  @@index([status])
  @@map("property_publication_versions")
}

/// Explicit public-media allowlist — only rows here are ever servable
/// publicly, and only ever `PropertyMediaType.IMAGE` (validated in
/// PublicationsService, not the DB). Never a blanket "publish every
/// private image" — see docs/PERMISSIONS.md "Public media rules".
model PropertyPublicationMedia {
  id        String                     @id @default(uuid()) @db.Uuid
  versionId String                     @db.Uuid
  version   PropertyPublicationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  propertyMediaId String        @db.Uuid
  propertyMedia   PropertyMedia @relation(fields: [propertyMediaId], references: [id], onDelete: Cascade)

  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  @@unique([versionId, propertyMediaId])
  @@index([versionId, sortOrder])
  @@map("property_publication_media")
}

/// Favorites a PUBLICATION (the marketplace listing), never the private
/// `Property` directly — see docs/PERMISSIONS.md "Marketplace favorite
/// vs. CRM shortlist". Any authenticated platform user may favorite,
/// independent of workspace membership.
model MarketplaceFavorite {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationId String              @db.Uuid
  publication   PropertyPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, publicationId])
  @@index([userId])
  @@index([publicationId])
  @@map("marketplace_favorites")
}
