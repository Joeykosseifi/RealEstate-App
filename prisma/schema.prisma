// Real Estate Platform — Prisma schema
//
// Milestone 0: datasource + generator only.
// Milestone 1: authentication, users, verification, sessions, and the
// minimum workspace/company/role foundation needed for automatic
// personal (agent) and company workspace creation on account activation.
// Milestone 2: the full authorization foundation — workspace/platform
// role scoping, the permission catalog, platform (admin) roles, and the
// moderation fields user suspension/deactivation/restoration need.
// Milestone 3 (this revision): the professional private property
// database — Property and its related models (location, features,
// media, owner contacts, private details). See docs/DATABASE.md for the
// full model-introduction schedule and the rationale behind specific
// design choices (e.g. `User.pendingCompanyProfile`, the workspace type
// CHECK constraint, the Role scope/uniqueness design, and the
// Milestone 3 property design decisions below).
//
// Do not add CRM/matching/collaboration/publication/subscription models
// yet — those belong to later milestones. Publication status is
// deliberately NOT part of Property yet (Milestone 5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// The onboarding path chosen at registration. This drives onboarding
/// behavior only — it is never treated as an authorization signal.
/// Authorization is always resolved from workspace membership + role +
/// permissions (see docs/PERMISSIONS.md).
enum AccountType {
  CLIENT
  AGENT
  COMPANY
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum WorkspaceType {
  PERSONAL
  COMPANY
}

enum WorkspaceMembershipType {
  OWNER
  EMPLOYEE
  FREELANCE_AGENT
  COLLABORATOR
}

enum WorkspaceMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CompanyAccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Whether a Role/Permission applies platform-wide (admin capabilities,
/// held via UserPlatformRole, independent of any workspace membership)
/// or within a single workspace (held via WorkspaceMember.roleId). A
/// WORKSPACE-scope role can only ever be granted WORKSPACE-scope
/// permissions — enforced in RolesService, not just by convention. See
/// docs/PERMISSIONS.md "Platform vs. workspace scope".
enum AuthorizationScope {
  PLATFORM
  WORKSPACE
}

// ---------------------------------------------------------------------------
// Users, sessions, verification, password reset
// ---------------------------------------------------------------------------

model User {
  id            String        @id @default(uuid()) @db.Uuid
  firstName     String
  lastName      String
  /// Always stored lowercased/trimmed — see UsersService.normalizeEmail.
  email         String        @unique
  /// E.164 format when present — see UsersService.normalizePhone.
  phone         String?       @unique
  passwordHash  String
  accountType   AccountType
  accountStatus AccountStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  lastLoginAt     DateTime?

  /// Moderation fields track only the MOST RECENT action of each kind —
  /// full history (actor, reason, previous/new status, timestamp) lives
  /// in AuditLog. These are plain scalar "actor" references (not Prisma
  /// relations) to avoid a self-relation explosion on User; a DB-level
  /// FK is still added by hand in the Milestone 2 migration. See
  /// docs/SECURITY.md "Reversible moderation".
  suspendedAt       DateTime?
  suspendedByUserId String?   @db.Uuid
  suspensionReason  String?

  deactivatedAt       DateTime?
  deactivatedByUserId String?   @db.Uuid
  deactivationReason  String?

  restoredAt       DateTime?
  restoredByUserId String?   @db.Uuid
  restoreReason    String?

  /// Transient staging area for a COMPANY registration's company details
  /// (name/email/phone/website/description), captured at registration and
  /// consumed by the activation transaction once the user verifies email
  /// + phone. Cleared (set null) once Company/Workspace/OWNER membership
  /// are created. See docs/DATABASE.md for why this isn't its own table.
  pendingCompanyProfile Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions             UserSession[]
  emailVerifications   EmailVerification[]
  phoneVerifications   PhoneVerification[]
  passwordResets       PasswordReset[]
  workspaceMemberships WorkspaceMember[]
  personalWorkspace    Workspace?          @relation("PersonalWorkspaceOwner")
  companiesCreated     Company[]           @relation("CompanyCreatedBy")
  auditLogs            AuditLog[]          @relation("AuditActor")
  platformRoles        UserPlatformRole[]
  createdProperties    Property[]          @relation("PropertyCreatedBy")

  @@map("users")
}

/// One row per logged-in device/session. The refresh token presented by
/// the client encodes this row's id plus a random secret; only a hash of
/// the secret is stored here. See docs/SECURITY.md "Refresh token
/// rotation" for the full rotation + reuse-detection design.
model UserSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  userAgent String?
  ipAddress String?

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_sessions")
}

/// Link-style email verification. `tokenHash` is a SHA-256 hash of a
/// high-entropy random token; the raw token is only ever sent to the user
/// (via the mail provider) and never persisted or logged.
model EmailVerification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verifications")
}

/// Numeric-OTP phone verification. `otpHash` is a SHA-256 hash of the
/// code; lookup is always by userId (not by hash), so no uniqueness
/// constraint is needed on the hash itself.
model PhoneVerification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("phone_verifications")
}

/// Password reset token. Same shape/rationale as EmailVerification.
model PasswordReset {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Workspace / company / role foundation
//
// Full workspace management (invitations, switching, permission
// enforcement engine) is Milestone 2. This milestone only implements what
// account activation needs: creating exactly one PERSONAL workspace per
// agent, and one COMPANY workspace per company, each with an OWNER
// membership.
// ---------------------------------------------------------------------------

model Company {
  id                 String                    @id @default(uuid()) @db.Uuid
  name               String
  email              String?
  phone              String?
  website            String?
  /// Object storage reference (key/URL), wired up when file storage lands.
  logoUrl            String?
  description        String?
  verificationStatus CompanyVerificationStatus @default(PENDING)
  accountStatus      CompanyAccountStatus      @default(ACTIVE)

  createdByUserId String @db.Uuid
  createdBy       User   @relation("CompanyCreatedBy", fields: [createdByUserId], references: [id])

  workspace Workspace?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

/// A PERSONAL workspace has `personalOwnerUserId` set and `companyId`
/// null; a COMPANY workspace has `companyId` set and `personalOwnerUserId`
/// null. Enforced at the application layer AND by a DB CHECK constraint
/// (added by hand in the initial migration's migration.sql, under
/// prisma/migrations) plus the unique constraints below, which together
/// guarantee at most one personal workspace per user and at most one
/// workspace per company.
model Workspace {
  id   String        @id @default(uuid()) @db.Uuid
  type WorkspaceType
  name String

  personalOwnerUserId String? @unique @db.Uuid
  personalOwner       User?   @relation("PersonalWorkspaceOwner", fields: [personalOwnerUserId], references: [id])

  companyId String?  @unique @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  members     WorkspaceMember[]
  customRoles Role[]            @relation("WorkspaceCustomRoles")
  properties  Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  membershipType WorkspaceMembershipType
  status         WorkspaceMembershipStatus @default(ACTIVE)

  roleId String? @db.Uuid
  role   Role?   @relation(fields: [roleId], references: [id])

  /// Plain scalar actor references (see User's moderation fields for why
  /// these aren't Prisma relations) — full detail lives in AuditLog.
  invitedByUserId   String? @db.Uuid
  suspendedByUserId String? @db.Uuid
  removedByUserId   String? @db.Uuid

  invitedAt   DateTime?
  joinedAt    DateTime?
  suspendedAt DateTime?
  removedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Prevents duplicate memberships (and therefore duplicate OWNER grants)
  /// for the same user in the same workspace, even under concurrent
  /// activation attempts (enforced at the DB level, not just in code).
  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// A named, permission-bearing role. Two kinds:
///
/// - **System roles** (`isSystem: true`, `workspaceId: null`) — the fixed
///   catalog seeded by `prisma/seed.ts` (workspace roles like AGENT,
///   VIEWER, WORKSPACE_OWNER; platform roles like SUPER_ADMIN). Their
///   `key` must be globally unique — enforced by a hand-added partial
///   unique index (`WHERE "workspaceId" IS NULL`) in the Milestone 2
///   migration, since the ordinary composite `@@unique` below does not
///   by itself stop two different NULL-workspaceId rows from sharing a
///   key (NULL is never "equal" to NULL in a SQL unique constraint).
/// - **Custom workspace roles** (`isSystem: false`, `workspaceId` set) —
///   created by a workspace via `workspace.manage_roles` (e.g. "Senior
///   Agent"). `key` only needs to be unique within that one workspace,
///   which the composite `@@unique([workspaceId, key])` does enforce.
///
/// `scope` determines what a role's permissions may contain: a
/// WORKSPACE-scope role can only ever be granted WORKSPACE-scope
/// permissions (checked in RolesService whenever role-permission
/// mappings are written, for both system seeding and custom-role
/// CRUD) — a company admin can never construct a role carrying a
/// PLATFORM permission. Platform roles are assigned to users directly
/// via `UserPlatformRole`, never via `WorkspaceMember.roleId`.
model Role {
  id          String             @id @default(uuid()) @db.Uuid
  key         String
  name        String
  description String?
  scope       AuthorizationScope @default(WORKSPACE)
  isSystem    Boolean            @default(false)

  /// Set only for custom (non-system) workspace roles.
  workspaceId String?    @db.Uuid
  workspace   Workspace? @relation("WorkspaceCustomRoles", fields: [workspaceId], references: [id], onDelete: Cascade)

  permissions   RolePermission[]
  members       WorkspaceMember[]
  platformGrant UserPlatformRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, key])
  @@index([scope])
  @@map("roles")
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  key         String             @unique
  description String?
  scope       AuthorizationScope

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@index([scope])
  @@map("permissions")
}

/// Grants a PLATFORM-scope Role directly to a User, independent of any
/// workspace membership — this is how SUPER_ADMIN/PLATFORM_ADMIN/etc.
/// work without requiring the admin to join every workspace they
/// administer. RolesService rejects granting a WORKSPACE-scope role here.
model UserPlatformRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  /// Plain scalar actor reference — see User's moderation fields.
  grantedByUserId String? @db.Uuid

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_platform_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

/// Append-only audit trail. Never write secrets (passwords, tokens, OTPs)
/// into `metadata` — see docs/SECURITY.md.
model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  actorUserId String? @db.Uuid
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Milestone 3 — Property database
//
// A Property belongs to exactly one workspace (its business owner) —
// `workspaceId` is never changeable via update, only set at creation.
// `createdByUserId` is a separate concept: the person who entered the
// record, which may differ from the workspace (e.g. a company employee
// creating a property that belongs to the company workspace, not their
// own personal one). See docs/PERMISSIONS.md "Property ownership vs.
// authorship."
//
// Business status (this milestone) and publication status (Milestone 5,
// not modeled yet) are deliberately separate concerns — see
// docs/PERMISSIONS.md "Property status model."
// ---------------------------------------------------------------------------

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  LAND
  OFFICE
  SHOP
  COMMERCIAL
  WAREHOUSE
  BUILDING
  CHALET
  OTHER
}

enum ListingPurpose {
  SALE
  RENT
}

/// Business status only — never conflated with publication status
/// (Milestone 5). ARCHIVED is reached via the archive endpoint, not a
/// direct status-change call — see PropertiesService.
enum PropertyBusinessStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  OFF_MARKET
  ARCHIVED
}

/// How the saved lat/lng was obtained — captured for provenance, not
/// authorization. The database coordinates are the source of truth
/// regardless of source; googlePlaceId is a convenience reference, never
/// relied on exclusively (see docs/PERMISSIONS.md "Google Maps
/// strategy").
enum PropertyLocationSource {
  GOOGLE_SEARCH
  MAP_PIN
  CURRENT_LOCATION
  MANUAL
}

/// Independent of workspace-level permissions — this is the FUTURE
/// public/marketplace visibility rule (consumed starting Milestone 5/6).
/// Milestone 3 only enforces the professional-side permission
/// (`property.view_exact_location`) for exposing coordinates within a
/// workspace; it does not yet build any public/client-facing endpoint
/// that reads this field.
enum PropertyLocationVisibility {
  PRIVATE
  WORKSPACE
  PUBLIC_APPROXIMATE
  PUBLIC_EXACT
}

enum PropertyMediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Property {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdByUserId String @db.Uuid
  createdBy       User   @relation("PropertyCreatedBy", fields: [createdByUserId], references: [id])

  propertyType   PropertyType
  listingPurpose ListingPurpose
  title          String
  description    String?

  /// Stored as Decimal (never float) to avoid rounding drift; mapped to
  /// a plain `number` in API responses (see property.mapper.ts) — safely
  /// within JS's safe-integer range for realistic property prices.
  price    Decimal @db.Decimal(14, 2)
  currency String  @db.Char(3)

  bedrooms    Int?
  bathrooms   Int?
  areaSqm     Decimal? @db.Decimal(10, 2)
  floor       Int?
  totalFloors Int?
  yearBuilt   Int?

  propertyStatus PropertyBusinessStatus @default(AVAILABLE)

  /// Plain scalar actor reference (see User's moderation fields for the
  /// established rationale) — full detail lives in AuditLog.
  archivedAt       DateTime?
  archivedByUserId String?   @db.Uuid

  location       PropertyLocation?
  features       PropertyFeature[]
  media          PropertyMedia[]
  owners         PropertyOwner[]
  privateDetails PropertyPrivateDetails?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, propertyStatus])
  @@index([workspaceId, propertyType])
  @@index([workspaceId, listingPurpose])
  @@index([workspaceId, price])
  @@index([createdByUserId])
  @@map("properties")
}

/// One-to-one with Property. The exact coordinates are the permanent
/// source of truth once saved — see docs/PERMISSIONS.md "Google Maps
/// strategy." `Decimal(9,6)` comfortably covers the valid ranges
/// (latitude -90..90, longitude -180..180) at ~0.11m precision.
model PropertyLocation {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @unique @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  country String?
  region  String?
  city    String?
  area    String?
  address String?

  latitude      Decimal @db.Decimal(9, 6)
  longitude     Decimal @db.Decimal(9, 6)
  googlePlaceId String?

  locationSource     PropertyLocationSource     @default(MANUAL)
  locationVisibility PropertyLocationVisibility @default(PRIVATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([area])
  @@index([country, city, area])
  @@map("property_locations")
}

/// Flexible feature/amenity storage — a normalized key + boolean value,
/// not one column per amenity, so adding a new feature never requires a
/// migration. `featureKey` is validated at the API layer against
/// `apps/api/src/properties/property-features.catalog.ts` (the same
/// "single source of truth catalog" pattern as permissions), not by a
/// DB-level enum/foreign key — see docs/DATABASE.md "Property feature
/// storage."
model PropertyFeature {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  featureKey String
  value      Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([propertyId, featureKey])
  @@map("property_features")
}

/// `storageKey` is an opaque object-storage reference, never a public
/// URL — see StorageService. Exactly one row per property may have
/// `isPrimary = true`, enforced by a hand-added partial unique index in
/// this milestone's migration (see docs/DATABASE.md "Main photo rule").
model PropertyMedia {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  mediaType        PropertyMediaType
  storageKey       String
  originalFileName String
  mimeType         String
  fileSize         Int
  sortOrder        Int               @default(0)
  isPrimary        Boolean           @default(false)

  uploadedByUserId String @db.Uuid

  createdAt DateTime @default(now())

  @@index([propertyId, sortOrder])
  @@map("property_media")
}

/// Private professional data — never included in any public DTO. Access
/// requires `property.view_owner`, independent of `property.view`. A
/// property may have more than one owner/contact row (co-owners, an
/// agent-side contact, etc.).
model PropertyOwner {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  fullName      String
  phone         String?
  email         String?
  whatsappPhone String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@map("property_owners")
}

/// One-to-one with Property. `internalNotes`/`acquisitionSource`/
/// `internalReference`/`privateStatusNotes` require
/// `property.view_private_notes`; `commissionNotes` additionally
/// requires `property.view_commission` on top of that — see
/// docs/PERMISSIONS.md "Sensitive property fields."
model PropertyPrivateDetails {
  propertyId String   @id @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  internalNotes      String?
  commissionNotes    String?
  acquisitionSource  String?
  internalReference  String?
  privateStatusNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("property_private_details")
}
